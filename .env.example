# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://report_agent:change_me@localhost:5433/report_agent
POSTGRES_PASSWORD=change_me

# LLM for the agent (Day 6)
ANTHROPIC_API_KEY=
# Optional: which Claude model the agent uses (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
